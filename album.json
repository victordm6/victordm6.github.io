, só pra chegar mais uma vez em você."}],"giver":"Edu","joined":"Edu & Ana","initials":"E & A","folio":19}},{"pageId":"quebraCabeca","live":{"kind":"quebraCabeca","id":"quebraCabeca","photo":"/photos/42.png","caption":null,"giver":"Edu","receiver":"Ana","joined":"Edu & Ana","initials":"E & A","year":2026,"folio":20}},{"pageId":"raspadinha","live":{"kind":"raspadinha","id":"raspadinha","photoPool":["/photos/43.jpeg","/photos/44.jpeg","/photos/45.png","/photos/46.jpeg"],"captions":["","","",""],"giver":"Edu","receiver":"Ana","joined":"Edu & Ana","initials":"E & A","folio":21}},{"pageId":"musica","live":{"kind":"musica","id":"musica","musicLink":"https://www.youtube.com/watch?v=3IUpXaFsW64","title":"O CÉU EXPLICA TUDO","channelTitle":"Henrique e Juliano","durationLabel":"2:29","photos":["/photos/15.png","/photos/47.jpeg"],"pageTitle":null,"giver":"Edu","receiver":"Ana","joined":"Edu & Ana","initials":"E & A","folio":22}},{"pageId":"lanterna","live":{"kind":"lanterna","id":"lanterna","giver":"Edu","receiver":"Ana","joined":"Edu & Ana","initials":"E & A","photos":[{"url":"/photos/3.jpeg","caption":""},{"url":"/photos/1.jpeg","caption":""},{"url":"/photos/4.jpeg","caption":""},{"url":"/photos/5.jpeg","caption":""},{"url":"/photos/6.png","caption":""},{"url":"/photos/7.jpeg","caption":""},{"url":"/photos/8.jpeg","caption":""},{"url":"/photos/9.jpeg","caption":""},{"url":"/photos/10.jpeg","caption":""},{"url":"/photos/11.png","caption":""},{"url":"/photos/12.jpeg","caption":""},{"url":"/photos/13.jpeg","caption":""}],"folio":23}},{"pageId":"camera","live":{"kind":"camera","id":"camera","giver":"Edu","receiver":"Ana","joined":"Edu & Ana","initials":"E & A","photos":[{"url":"/photos/3.jpeg","caption":""},{"url":"/photos/1.jpeg","caption":""},{"url":"/photos/4.jpeg","caption":""},{"url":"/photos/5.jpeg","caption":""},{"url":"/photos/6.png","caption":""},{"url":"/photos/7.jpeg","caption":""},{"url":"/photos/8.jpeg","caption":""},{"url":"/photos/9.jpeg","caption":""},{"url":"/ph